#!/bin/sh
# Refuses to push commits that are unsigned or carry a bad signature.
# Checks every commit being pushed that the remote does not already have.
# Enable once per clone: git config core.hooksPath .githooks

remote="$1"
zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
unsigned=""

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue # deleting a remote ref, nothing to check

    for commit in $(git rev-list "$local_sha" --not --remotes="$remote"); do
        # The signature lives in the commit header (gpgsig / gpgsig-sha256), before the first blank line.
        if ! git cat-file commit "$commit" | sed '/^$/q' | grep -q '^gpgsig'; then
            unsigned="$unsigned
  $(git log -1 --format='%h %s (unsigned)' "$commit")"
        elif [ "$(git log -1 --format=%G? "$commit")" = "B" ]; then
            unsigned="$unsigned
  $(git log -1 --format='%h %s (bad signature)' "$commit")"
        fi
    done
done

if [ -n "$unsigned" ]; then
    echo "pre-push: refusing to push commits without a valid signature:$unsigned" >&2
    echo "pre-push: re-sign them, e.g.: git rebase --force-rebase --committer-date-is-author-date <base>" >&2
    exit 1
fi

exit 0
