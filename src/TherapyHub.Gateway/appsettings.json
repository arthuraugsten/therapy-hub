{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Authority": "",
    "Audience": "therapy-hub-api"
  },
  "RateLimiting": {
    "PerUser": {
      "PermitLimit": 30,
      "WindowSeconds": 10
    }
  },
  "ReverseProxy": {
    "Routes": {
      "api": {
        "ClusterId": "api",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "per-user",
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "api": {
        "Destinations": {
        }
      }
    }
  }
}
